{
  "name": "sendai",
  "version": "1.0.0",
  "description": "Pi Agent with Kubernetes-leased sandbox execution",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "start": "node --import tsx/esm src/server.ts",
    "start:worker": "node --import tsx/esm src/worker/index.ts",
    "build": "tsc",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "stress": "tsx tests/stress/stress.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@kubernetes/client-node": "^1.0.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2",
    "dotenv": "^16.5.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
