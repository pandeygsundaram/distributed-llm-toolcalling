# Anthropic API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local sandbox directory for Phase 1 (tool execution runs here)
SANDBOX_DIR=./sandbox

# API server port
PORT=3000

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# ── Phase 2 (Kubernetes + Redis) ─────────────────────────────────────────────

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Kubernetes namespace for sandbox pods
K8S_NAMESPACE=sendai

# Max time (ms) a tool call waits in queue before failing
QUEUE_MAX_WAIT_MS=15000

# Max time (ms) a tool call is allowed to run in a pod
TOOL_TIMEOUT_MS=30000

# Kubernetes Lease TTL (seconds) — must be > TOOL_TIMEOUT_MS/1000
LEASE_TTL_SECONDS=45
